{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "baseRevision", "operations", "selfCheck"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "baseRevision": { "type": "integer", "minimum": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["op", "scope", "value"],
            "properties": {
              "op": { "const": "add" },
              "scope": { "$ref": "#/$defs/scope" },
              "value": { "type": "object", "required": ["id"] }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "scope", "id", "patch"],
            "properties": {
              "op": { "const": "update" },
              "scope": { "$ref": "#/$defs/scope" },
              "id": { "type": "string", "minLength": 1 },
              "patch": { "type": "object", "minProperties": 1 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "scope", "id", "confirmation"],
            "properties": {
              "op": { "const": "delete" },
              "scope": { "$ref": "#/$defs/scope" },
              "id": { "type": "string", "minLength": 1 },
              "confirmation": { "const": true }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "selfCheck": {
      "type": "object",
      "required": ["reviewed", "noOutOfScopeChanges", "noUnrequestedDeletes", "noUnsupportedImagePaths", "notes"],
      "properties": {
        "reviewed": { "const": true },
        "noOutOfScopeChanges": { "const": true },
        "noUnrequestedDeletes": { "const": true },
        "noUnsupportedImagePaths": { "const": true },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": { "enum": ["flows", "educationMaterials", "educationGroups", "contacts", "locations"] }
  }
}
