# Build the private /login and /dashboard routes.
# Runtime access still requires a Neon Auth account in public.admin_users.
VITE_ENABLE_DEV_DASHBOARD=false

# Bypass authentication with a mock admin account. Use only for local testing;
# requires VITE_ENABLE_DEV_DASHBOARD=true to expose the dashboard routes.
# Disabling auth never authorizes database writes.
VITE_DISABLE_AUTH=false

# Optional settings for the local AI-agent bridge (not exposed to Vite).
# BEMTEVI_AGENT_BRIDGE_PORT=4318
# BEMTEVI_AGENT_BRIDGE_CODE=123456
# BEMTEVI_CODEX_COMMAND=C:\path\to\codex.exe
# BEMTEVI_CLAUDE_COMMAND=C:\path\to\claude.exe
# BEMTEVI_HERMES_COMMAND=C:\path\to\hermes.exe

# Public Neon endpoints from the project's Auth and Data API configuration.
# No database connection string or Neon API key belongs in a VITE_* variable.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=

# Enable first-party, aggregate-only daily page counters in production builds.
# The database migration must be applied before switching this on.
VITE_ENABLE_PAGE_ANALYTICS=false
